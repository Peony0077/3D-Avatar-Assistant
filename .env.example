# Copy to .env to change defaults.
# Open-source TTS server (npm run tts)
TTS_URL=http://127.0.0.1:8882
# Optional OpenAI-compatible chat endpoint for assistant replies (e.g. Ollama: `ollama serve`).
LLM_BASE_URL=http://127.0.0.1:11434
VITE_LLM_MODEL=
VITE_LLM_SYSTEM_PROMPT=You are a friendly, concise virtual assistant. Answer in one to three short sentences.
